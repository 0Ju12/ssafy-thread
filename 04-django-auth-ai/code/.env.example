# 이 파일을 복사해 .env 로 이름을 바꾼 뒤 값을 채우세요. (.env 는 GitLab 에 올리지 않습니다)

# SSAFY 에서 발급받은 GMS API Key (F417 작가 정보 · AI 도서 분석 · AI 맞춤 추천에 사용)
GMS_KEY=

# 사용할 모델 (비워 두면 gpt-5-nano)
# ※ 명세서 : 제공 GMS API Key 사용 시 gpt-5-nano 필수 => 제출할 때는 비워 두거나 gpt-5-nano 로
# GMS_MODEL=gpt-6.1-sol
GMS_MODEL=

# 알라딘 TTB Key : 최신 도서 가져오기 (python manage.py import_books)
# 발급 : https://www.aladin.co.kr/ttb/wblog_manage.aspx
TTBKEY=

# 위키피디아 API User-Agent 에 넣을 연락처 (영문 이메일, 없어도 동작하지만 요청 한도가 작아짐)
WIKI_CONTACT=
